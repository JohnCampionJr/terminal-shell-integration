<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only. The library references nothing but the BCL, and it ships to nuget.org.
       No private source, and never a credential: a fresh clone must restore with no secrets. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
